# Deployment-owned OpenAI-compatible provider (server only)
OPENAI_API_KEY=
BASE_URL=https://api.openai.com
# Development only: allow HTTP for loopback Hosted upstreams such as Ollama.
ALLOW_INSECURE_LOCAL_UPSTREAM=false
MODELS=gpt-4.1-mini
DEFAULT_MODEL=gpt-4.1-mini
TITLE_MODEL=gpt-4.1-mini

# Hosted access. ACCESS_CODE accepts comma-separated non-empty codes; each code
# is limited to 256 UTF-8 bytes. Use random long values for a public deployment.
# Generate AUTH_SECRET with at least 32 random bytes. Never reuse an API key.
# Vercel WAF rate limiting is project Firewall configuration, not an env value.
ACCESS_CODE=
AUTH_SECRET=

# Optional hosted web search. Available only to users signed in with ACCESS_CODE.
# WEB_SEARCH_PROVIDER is always the default. Omit the allowlist to lock it, or
# list every provider that access-code users may select in Settings.
WEB_SEARCH_PROVIDER=tavily
# WEB_SEARCH_ALLOWED_PROVIDERS=tavily,grok
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
GROK_API_KEY=
GROK_RESPONSES_URL=https://api.x.ai/v1/responses
GROK_MODEL=grok-4.5
GROK_X_SEARCH=false

# Optional hosted image generation. Configure all three values together.
# The base URL may be a provider root or an address ending in /v1.
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_BASE_URL=https://api.openai.com
IMAGE_GENERATION_MODEL=gpt-image-2
# For multiple hosted image profiles, set IMAGE_GENERATION_PROFILES to a JSON array
# of {id,name,apiKey,baseUrl,model,sizeMode} objects and leave the three legacy
# IMAGE_GENERATION_* values empty. IDs are selected by the client.
IMAGE_GENERATION_PROFILES=
IMAGE_GENERATION_DEFAULT_PROFILE=
# Set to 0 to disable the request timeout. Request size is a whole number of MB.
IMAGE_GENERATION_TIMEOUT_SECONDS=300
IMAGE_GENERATION_MAX_REQUEST_MB=8

# Set to true to expose hosted access only.
DISABLE_BYOK=false

# Request timeouts in seconds. Set an individual value to 0 to disable it.
MODEL_LIST_TIMEOUT_SECONDS=30
CHAT_FIRST_BYTE_TIMEOUT_SECONDS=300
CHAT_IDLE_TIMEOUT_SECONDS=300
CHAT_TOTAL_TIMEOUT_SECONDS=1800
